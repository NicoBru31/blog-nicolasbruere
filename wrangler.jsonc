{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog-nicolasbruere",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  // Must match SITE.url (src/lib/site.ts). Cloudflare creates the DNS record and the certificate.
  "routes": [{ "pattern": "bruerenicolas.me", "custom_domain": true }],
  // Prerendered pages are `posts/x/index.html`: serve them at `/posts/x` (the canonical URL) and
  // redirect `/posts/x/` there, instead of Cloudflare's default of adding the slash.
  "assets": { "html_handling": "drop-trailing-slash" },
}
